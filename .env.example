# Local MySQL development only. Copy to .env and choose non-production values.
LIFEOS_MYSQL_DATABASE=lifeos
LIFEOS_MYSQL_USER=lifeos
LIFEOS_MYSQL_PASSWORD=change-me
LIFEOS_MYSQL_ROOT_PASSWORD=change-root-me
LIFEOS_MYSQL_PORT=3306

# Spring Boot local datasource
LIFEOS_DB_URL=jdbc:mysql://localhost:3306/lifeos?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
LIFEOS_DB_USERNAME=lifeos
LIFEOS_DB_PASSWORD=change-me
